<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline-first: no INTERNET permission. Local notifications only. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".MomentumApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Momentum">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Momentum">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Local reminders: exact alarms → receiver → WorkManager post. -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".notification.CompleteActionReceiver"
            android:exported="false" />
        <!-- Recovery: reboot (alarms don't survive) + timezone/clock changes
             (wall-clock alarms shift meaning). All trigger the central resync. -->
        <receiver
            android:name=".notification.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
